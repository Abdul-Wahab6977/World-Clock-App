{
  "name": "world-clock-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "build:web": "npx expo export -p web && node -e \"const fs=require('fs'); const files=fs.readdirSync('dist/_expo/static/js/web/'); const jsFile=files.find(f=>f.startsWith('AppEntry')); let html=fs.readFileSync('public/index.html','utf8'); html=html.replace('</body>', `<script src=\\\"/_expo/static/js/web/${jsFile}\\\"></script></body>`); fs.writeFileSync('dist/index.html', html); console.log('✅ index.html created in dist/');\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "expo": "^57.0.16",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.13",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "^57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0"
  }
}
